0:{"buildId":"su9OEHPJRB69dffjjRAYs","data":[{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","main",null,{"className":"story-page","children":[["$","section",null,{"className":"story-hero","style":{"backgroundImage":"url(/_next/static/media/banner.1hyjz17ga-sr6.jpg)"},"children":[["$","div",null,{"className":"story-hero-overlay"}],["$","div",null,{"className":"story-hero-inner","children":[["$","p",null,{"className":"section-eyebrow","children":"Our Story"}],["$","h1",null,{"children":"Our History"}],["$","p",null,{"children":"From a roadside shrimp business to a Louisiana seafood tradition that has stood the test of time."}]]}]]}],[["$","section","A Dream Born From Unexpected Fate",{"className":"story-section ","children":["$","div",null,{"className":"story-section-inner","children":["$","div",null,{"className":"story-section-content","children":[["$","p",null,{"className":"section-eyebrow","children":"The Beginning · 1982"}],["$","h2",null,{"children":"A Dream Born From Unexpected Fate"}],[["$","p","In 1982, Kathi Bonamici Vidrine and her three daughters found themselves in the coastal community of Lake Charles, Louisiana, through an act of unexpected fate.",{"children":"In 1982, Kathi Bonamici Vidrine and her three daughters found themselves in the coastal community of Lake Charles, Louisiana, through an act of unexpected fate."}],["$","p","With very little money, no friends or family in the area, and a strong will for survival, Kathi developed an unrelenting dream for success.",{"children":"With very little money, no friends or family in the area, and a strong will for survival, Kathi developed an unrelenting dream for success."}],["$","p","She recognized being an entrepreneur was God's calling in her life, even though she had very little know-how in the business. She was sure her passion and work ethic would supersede her inadequacies.",{"children":"She recognized being an entrepreneur was God's calling in her life, even though she had very little know-how in the business. She was sure her passion and work ethic would supersede her inadequacies."}]]]}]}]}],["$","section","From The Roadside To The Community",{"className":"story-section story-section-alt","children":["$","div",null,{"className":"story-section-inner","children":["$","div",null,{"className":"story-section-content","children":[["$","p",null,{"className":"section-eyebrow","children":"The Shrimp Lady"}],["$","h2",null,{"children":"From The Roadside To The Community"}],[["$","p","Kathi took a chance and began her journey as a businesswoman in the shrimping industry, first in Leesville, Louisiana.",{"children":"Kathi took a chance and began her journey as a businesswoman in the shrimping industry, first in Leesville, Louisiana."}],["$","p","Because Leesville was known for being friendly to peddlers, she commuted there daily to sell her shrimp supply on the side of the road.",{"children":"Because Leesville was known for being friendly to peddlers, she commuted there daily to sell her shrimp supply on the side of the road."}],["$","p","Her bubbly personality, integrity, and genuine love for humanity won her the respect of the public.",{"children":"Her bubbly personality, integrity, and genuine love for humanity won her the respect of the public."}],["$","p","\"Kathi, the Shrimp Lady\" had become a staple in the business community.",{"children":"\"Kathi, the Shrimp Lady\" had become a staple in the business community."}]]]}]}]}],["$","section","A Family Business Takes Shape",{"className":"story-section ","children":["$","div",null,{"className":"story-section-inner","children":["$","div",null,{"className":"story-section-content","children":[["$","p",null,{"className":"section-eyebrow","children":"Growing The Business"}],["$","h2",null,{"children":"A Family Business Takes Shape"}],["$L3","$L4","$L5"]]}]}]}],"$L6","$L7"],"$L8"]}],"$L9"],["$La"],"$Lb"]}],"isPartial":"$@c","staleTime":"$d","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$d","var